{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "chrome"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@bookmakers/*": ["../extension/src/bookmakers/*"],
      "@betanal/shared": ["../shared/src/index.ts"],
      "@betanal/shared/fixtures/bets": ["../shared/src/__fixtures__/bets.normalized.json"]
    }
  },
  "include": ["src", "vite.config.ts", "../extension/src/bookmakers/*/bookmaker.json"]
}
